[Unit]
Description=ListenMore: draft reflections for newly finished books (and, Fri/Sat, the weekly book insights)
After=network-online.target rclone-dropbox.service
Wants=network-online.target
OnFailure=listenmore-drafts-notify-failure.service

[Service]
Type=oneshot
WorkingDirectory=%h/Projects/ListenMore/desktop
ExecStart=%h/Projects/ListenMore/desktop/nightly.sh
TimeoutStartSec=900
